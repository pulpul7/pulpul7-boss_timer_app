{
   "background": {
      "service_worker": "js/background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": true,
      "css": [ "css/content-style.css" ],
      "js": [ "js/contentscript-service.js", "js/contentscript-background.js" ],
      "matches": [ "http://m.calendar.naver.com/*", "https://m.calendar.naver.com/*" ],
      "run_at": "document_end"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "default_locale": "ko",
   "description": "__MSG_APP_DESCRIPTION__",
   "host_permissions": [ "http://m.calendar.naver.com/*", "https://m.calendar.naver.com/*", "https://calendar.naver.com/*" ],
   "icons": {
      "128": "img/icon128.png",
      "16": "img/icon16.png",
      "32": "img/icon32.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_APP_NAME__",
   "permissions": [ "activeTab", "idle", "notifications", "scripting", "storage", "tabs", "offscreen" ],
   "sidebar_action": {
      "custom_user_agent": "naver-calendar",
      "default_icon": {
         "128": "img/icon128.png",
         "16": "img/icon16.png",
         "32": "img/icon32.png"
      },
      "default_page": "index.html",
      "default_title": "__MSG_APP_NAME__",
      "mobile_user_agent": false,
      "use_navigation_bar": false
   },
   "update_url": "https://store.whale.naver.com/update/whx",
   "version": "2026.15.2",
   "web_accessible_resources": [ {
      "matches": [ "https://m.calendar.naver.com/*" ],
      "resources": [ "offscreen.html", "js/offscreen.js", "js/contentscript-background.js" ]
   } ],
   "whale_extension": true
}
