{
   "background": {
      "service_worker": "service_worker.js"
   },
   "content_security_policy": {
   },
   "declarative_net_request": {
      "rule_resources": [ {
         "enabled": true,
         "id": "ruleset",
         "path": "rules.json"
      } ]
   },
   "description": "Allow Whale browser to play HLS video urls (m3u8)",
   "host_permissions": [ "*://*/*.m3u8*" ],
   "incognito": "split",
   "key": "",
   "manifest_version": 3,
   "name": "Whale HLS Player",
   "permissions": [ "declarativeNetRequest" ],
   "update_url": "https://store.whale.naver.com/update/whx",
   "version": "0.3.2",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "*.js", "*.html" ]
   } ],
   "whale_extension": true
}
