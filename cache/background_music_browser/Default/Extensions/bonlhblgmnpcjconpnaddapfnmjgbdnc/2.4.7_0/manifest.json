{
   "background": {
      "service_worker": "background.min.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": true,
      "css": [ "contentscript.css" ],
      "js": [ "contentscript.min.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_start"
   } ],
   "default_locale": "en",
   "description": "Translate texts from image.",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "16": "icons/papago.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_whale_version": "3.24",
   "name": "__MSG_APP_NAME__",
   "permissions": [ "metricsPrivate", "activeTab", "contextMenus", "declarativeNetRequest", "utility", "storage", "tabs", "webRequest", "pageCapture", "management", "offscreen" ],
   "update_url": "https://store.whale.naver.com/update/whx",
   "version": "2.4.7",
   "whale_extension": true
}
