{
  "schema": 1,
  "purpose": "agent_navigation_index_not_exhaustive_dependency_graph",
  "verified_on": "2026-10-22",
  "usage": {
    "start": [
      "AGENTS.md",
      "CODEMAP.json"
    ],
    "route": "Match issue terms to routes; read only that route's files and symbol bodies first. Follow real callers before editing.",
    "symbols": "file.py#Class.method or file.py#function; search these names, not saved line numbers.",
    "flow": "Navigation index, not an exhaustive dependency graph. Async/IPC boundaries are in process_tree.",
    "maintenance": "Manage this as an AI code-navigation index. After debugging decide whether a new route is necessary; merge overlapping routes rather than duplicating entries. Keep only verified current code locations, symbols and dependencies. Remove stale information, update affected paths/tests and verified_on. Store causes, fixes and validation history separately in DEBUG_NOTES.json.",
    "reading": "Do not print entire GUI or giant HTML/JS lines. Use rg -n --max-columns 220 --max-columns-preview or AST to find a symbol, then read its bounded body. Embedded image/audio data can occupy a single huge line.",
    "safety": "Read-only navigation. No build, helper invocation, migration, live update, resource synchronization or user-data mutation merely to inspect structure.",
    "debug_records": "DEBUG_NOTES.json (separate, not a dependency source)"
  },
  "process_tree": {
    "gui": {
      "entry": "boss_timer_gui.py#main",
      "owns": [
        "Tk main thread",
        "schedule state",
        "settings/profile orchestration",
        "notice host",
        "Discord/web controllers"
      ],
      "launches": {
        "discord_bot": {
          "entry": "boss_timer_discord_bot.py#main",
          "boundary": "subprocess; local status HTTP + request files + voice bridge; remote authority through Discord control events"
        },
        "web_worker": {
          "entry": "web_service_worker.py#main",
          "boundary": "--boss-timer-web-worker; standalone background lifetime; snapshot/authority files + local HTTP/HTTPS"
        },
        "update_helper": {
          "entry": "program_update_helper.py#main",
          "boundary": "--boss-timer-apply-program-update; transaction journal + maintenance fence + process identities"
        }
      },
      "startup_dispatch": "Helper/web flags bypass ordinary GUI startup; normal entry routes active program version before GUI bootstrap."
    },
    "browser": {
      "entry": "web_assets/index.html",
      "logic": "web_assets/schedule.js",
      "boundary": "HTTP snapshot/settings/push APIs; per-browser storage; never assume nickname shares device settings"
    },
    "notice_plugin": {
      "entry": "notice_module/payload/main.py#create_plugin",
      "boundary": "loaded inside GUI via NoticeHost; installed module may override bundled payload"
    }
  },
